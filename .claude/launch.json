    {
      "name": "web-real",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-F",
        "@nad/web",
        "exec",
        "vite",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    }
  ]
}